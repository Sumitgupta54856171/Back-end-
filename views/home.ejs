<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./output.css">
    <title>Document</title>
</head>
<body class="bg-white w-full h-screen">
    <div class=" text-black flex flex-col justify-between ">
        <nav class="flex flex-row justify-between gap-4 bg-red-600 list-none py-6 ">
            <li>
                <a href="/user/">Home</a>
            <% if(user){%>
            <li>
                <a href="/user/logout">Logout</a>
            </li>
            <li>
                <a href="/user/profile">Profile</a>
            </li>
                 <%}else{%>
            <li>
                <a href="/login">Login</a>
            </li>
            <li>
                <a href="/user/signup">Sign</a>
            </li>
            <%}%>
        </nav>
    </div>
    <div>
        <small>welcome to home page of user</small>
    </div>
      <% homes.map(items => {%>
        <form action="/user/book" method="POST" class="flex flex-col justify-center">
        <div class="text-shadow-black border-0.5 md-4 box-border size-100 border-1 flex flex-col gap-2 rounded-md justify-center items-center">
            <div class=" text-black md-4 box-border size-40 border-red-100 "><img src="/<%= items.image.filePath %>" alt="items.image.name" class="w-full h-auto rounded-md object-cover size-4"  ></div>
            <small class="text-xl font-bold  text-black"><%= items.homename%></small>
            <small class="text-lg font-semibold  text-black"><%= items.duration %></small>
            <small class="text-xl font-bold  text-black"><%= items.price %></small>
            <small class="text-sm  text-black"><%= items.description %></small>
            <small class="text-lg font-semibold  text-black"><%= items.city %></small>
            <small class="text-lg font-semibold  text-black"><%= items.state %></small>
            <small class="text-lg font-semibold  text-black">Country : <%= items.country %></small>
           
            <input type="hidden" name="homename" value="<%= items.homename %>">
            <input type="hidden" name="duration" value="<%= items.duration %>">
            <input type="hidden" name="price" value="<%= items.price %>">
            <input type="hidden" name="description" value="<%= items.description %>">
            <input type="hidden" name="city" value="<%= items.city %>">
            <input type="hidden" name="state" value="<%= items.state %>">
            <input type="hidden" name="country" value="<%= items.country %>">
            <input type="hidden" name="image" value="<%= JSON.stringify(items.image) %>">
            <input type="hidden" name="email" value="<%= items.email %>">
            <input type="hidden" name="id" value="<%= items.email %>">
            
       
        <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Book Now</button>
         </div>
    </form>
        <%})%>
        
     <footer>
        <div class="bg-red-600 fixed text-white text-center bottom-4 py-4">
            <p>&copy; 2023 Your Company Name. All rights reserved.</p>
        </div>
     </footer>
</body>
</html>